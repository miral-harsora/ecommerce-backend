PORT=3001
# Paste the complete Atlas driver connection string; do not include Markdown escaping or placeholders.
MONGODBURL=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Comma-separated origins, e.g. https://your-site.netlify.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Use a long random value in deployed environments.
JWT_SECRET=replace-with-a-long-random-secret
# Optional: use this only if your local DNS resolver cannot resolve MongoDB SRV records.
# DNS_SERVERS=1.1.1.1,8.8.8.8
